# News Alpha Radar — 우분투 상시 서버 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요: cp .env.example .env && chmod 600 .env

# [필수] Google AI Studio API 키
# 참고: 무료 일일 한도(RPD)는 Google Cloud '프로젝트' 단위입니다.
# 서로 다른 프로젝트에서 발급한 키 여러 개를 GEMINI_API_KEYS=키1,키2 로 넣으면 일일 소진 시 자동 로테이션됩니다.
# (백테스트 실행 시에는 운영 서버와 다른 프로젝트 키를 사용하는 것을 권장합니다)
GEMINI_API_KEY=여기에_제미나이_API_키_입력
# GEMINI_API_KEYS=

# [필수] 텔레그램 봇 토큰 및 채팅 ID (알림 발송용)
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_텔레그램_채팅_ID_입력

# [선택·추천] 텔레그램 속보 채널 0초 실시간 콜백 수신용 (https://my.telegram.org 무료 발급)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 구독할 공개 속보 채널 @아이디 또는 t.me 링크 (쉼표 구분, 웹 대시보드에서도 실시간 편집 가능)
TELEGRAM_SOURCE_CHANNELS=

# [선택] 2단 초고속 1보 푸시 (true: Stage 1 통과 즉시 3초 만에 1보 속보 → 15초 뒤 2보 심층 리포트)
INSTANT_FLASH_ALERT=true

# [권장] 관리 웹 대시보드 & 외부 접속(LTE/5G) 보안 터널 설정
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
# 비워두면 외부 터널 활성화 시 안전한 12자리 비밀번호가 자동 생성되어 .env 저장 및 텔레그램으로 안내됩니다
DASHBOARD_PASSWORD=
# true: 별도 앱·포트포워딩 없이 Cloudflare 무료 HTTPS 외부 접속 주소를 자동 발급해 텔레그램으로 전송
DASHBOARD_TUNNEL_ENABLED=true

# [선택] 감시 기준 및 시간대별 알림 한도·편중·유동성 제어 (웹 대시보드에서도 실시간 변경 가능)
MIN_CATALYST_SCORE=7.5
# 장중(평일 08:00~15:30) / 야간·주말 알림 한도 분리 (구버전 MAX_DAILY_ALERTS 와 호환 유지)
MAX_MARKET_ALERTS=8
MAX_OFFHOURS_ALERTS=3
# MAX_DAILY_ALERTS=11
# 야간·주말 후보를 즉시 발송하지 않고 모아 평일 07:50에 "장전 요약" 1건으로 묶어 발송 (데몬 기본 true)
OFFHOURS_DIGEST_ENABLED=true
OFFHOURS_DIGEST_TIME=07:50
# 최근 N시간 내 이미 알림된 동일 종목코드 제외 (0=해제, +1.0점↑ 에스컬레이션 시 [후속] 허용)
STOCK_DEDUP_HOURS=24
# 동일 섹터(예: 사이버보안) 하루 최대 알림 건수 (0=제한없음)
MAX_DAILY_PER_SECTOR=2
# 정규장(09:00~15:30) 상승수혜 추천 종목 전원이 +N% 이상 이미 급등 선반영이면 추격 알림 차단 (0=해제)
MAX_BULLISH_PREPRICED_PCT=15.0
# 하이브리드 최소 유동성 기준(억 원): max(전일 거래대금, 당일 누적 거래대금)이 N억 원 미만인 극소형 상승수혜주 제외 (0=해제)
MIN_TRADING_VALUE_EOK=5.0
MAX_ALERTS_PER_RUN=2
THEME_COOLDOWN_HOURS=12
DEDUP_MODE=enforce
TRIGGER_MODE=enforce
STAGE1_DAILY_RPD_LIMIT=500

# [선택] 시간대별 백업 RSS 감시 주기(초) — 장중 60초 / 장전·장후 180초 / 심야·주말 600초
DAEMON_INTERVAL_MARKET_SEC=60
DAEMON_INTERVAL_EXTENDED_SEC=180
DAEMON_INTERVAL_OFFHOURS_SEC=600

# [선택] Gemini 모델 및 타임아웃 (독립 무료 RPD 버킷 5개 모델 자동 폴백)
GEMINI_SCREEN_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_DEEP_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_SCREEN_TIMEOUT=25
GEMINI_DEEP_TIMEOUT=25

# [선택] 모의투자 자동매매 (기본: 키 입력 없이 내장 1,000만원 실전형 가상계좌 즉시 가동)
# 한국투자증권(KIS Developers) 공식 모의투자 키를 입력하면 자동으로 한투 모의계좌(VTS) 주문으로 전환됩니다.
AUTOTRADE_ENABLED=true
AUTOTRADE_ORDER_AMOUNT_KRW=1000000
AUTOTRADE_MAX_POSITIONS=4
AUTOTRADE_MIN_CHANGE_PCT=-2.0
AUTOTRADE_MAX_CHANGE_PCT=2.0
AUTOTRADE_TAKE_PROFIT_PCT=5.0
AUTOTRADE_TRAILING_STOP_PCT=2.0
# 보유 중 +3.0% 도달 시 손절선을 본전(+0.3%)으로 상향 (0=비활성)
AUTOTRADE_BREAKEVEN_TRIGGER_PCT=3.0
AUTOTRADE_BREAKEVEN_FLOOR_PCT=0.3
AUTOTRADE_STOP_LOSS_PCT=3.0
# 장초반 호가 혼란 회피를 위한 시초 진입 시작 시각(09:08) 및 오후 신규 매수 마감 시각(14:00)
AUTOTRADE_OPEN_ENTRY_TIME=09:08
AUTOTRADE_ENTRY_CUTOFF_TIME=14:00
AUTOTRADE_EOD_EXIT_ENABLED=true
AUTOTRADE_EOD_EXIT_TIME=15:15
# 전일 급락주(-10% 이하)의 장전 대기열(09:08 시초 진입) 편입 차단 (0=비활성)
AUTOTRADE_PREMARKET_MAX_DROP_PCT=10.0
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_CANO=
# KIS_ACNT_PRDT_CD=01

# [선택] 비공개 GitHub 일별 수익률·성적표 자동 백업 (웹 대시보드 화면에서도 1회 등록 가능)
GITHUB_REPORT_REPO=jjangna0817-hue/news-alpha-radar-logs
# GITHUB_REPORT_TOKEN=

