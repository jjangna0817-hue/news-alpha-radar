[Unit]
Description=News Alpha Radar Web Management Dashboard
After=network-online.target news-alpha-radar.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=-__WORKDIR__/.env
ExecStart=__PYTHON__ -u __WORKDIR__/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
